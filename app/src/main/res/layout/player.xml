<?xml version="1.0" encoding="utf-8"?>
<!-- Into the window's own FrameLayout: the picture (a SurfaceView: DV and HDR need the hardware overlay plane), subtitles over it,
     the loading and pause screens (inflated when first shown), a centred message and a time bar shown on remote presses. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ViewStub
        android:id="@+id/pause_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/pause"
        android:layout="@layout/pause" />

    <ViewStub
        android:id="@+id/loading_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/loading"
        android:layout="@layout/loading" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="96dp"
        android:gravity="center"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bar_background"
        android:orientation="vertical"
        android:paddingHorizontal="64dp"
        android:paddingTop="48dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />

            <!-- The badges, for a few seconds after a load -->
            <LinearLayout
                android:id="@+id/bar_badges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_weight="1"
                android:max="1000" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#B3FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- A held ←/→'s picture of where it's going (SeekPreview), moved above the bar at the target -->
    <ViewStub
        android:id="@+id/preview_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:inflatedId="@+id/preview"
        android:layout="@layout/preview" />
</merge>
