<?xml version="1.0" encoding="utf-8"?>
<!-- Into the window's own FrameLayout: the picture (a SurfaceView: DV and HDR need the hardware overlay plane), subtitles over it,
     the loading and pause screens (inflated when first shown), a centred message, the time bar with the controls, and
     the lists and panel they open. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ViewStub
        android:id="@+id/pause_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/pause"
        android:layout="@layout/pause" />

    <ViewStub
        android:id="@+id/loading_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/loading"
        android:layout="@layout/loading" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="96dp"
        android:gravity="center"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:visibility="gone" />

    <!-- Skip intro / recap and the Next episode card (MarkerOverlay), under the bar and the lists -->
    <ViewStub
        android:id="@+id/markers_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/markers"
        android:layout="@layout/markers" />

    <!-- The time bar, shown on remote presses and while paused: a title row (the scrub's distance, the badges after a
         load), a thin bar with a round thumb, and the controls under it with the time, as in Stremio's player -->
    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bar_background"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="40dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bar_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowRadius="4"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- The badges, for a few seconds after a load (the pause screen has its own in the corner) -->
            <LinearLayout
                android:id="@+id/bar_badges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.media3.ui.DefaultTimeBar xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:focusable="false"
            android:importantForAccessibility="no"
            app:bar_height="4dp"
            app:buffered_color="#59FFFFFF"
            app:played_color="#FFFFFFFF"
            app:scrubber_color="#FFFFFFFF"
            app:scrubber_disabled_size="14dp"
            app:scrubber_enabled_size="14dp"
            app:touch_target_height="26dp"
            app:unplayed_color="#33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Play, jumps, episodes, subtitles, audio, speed, picture size, settings: Controls fills it -->
            <LinearLayout
                android:id="@+id/controls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFeatureSettings="tnum"
                android:shadowColor="#99000000"
                android:shadowRadius="4"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- A list opened from the controls (audio, speed, picture size, settings), on the right -->
    <ViewStub
        android:id="@+id/menu_stub"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:inflatedId="@+id/menu"
        android:layout="@layout/menu_panel" />

    <!-- The subtitles panel: languages, that language's tracks, the subtitles' settings -->
    <ViewStub
        android:id="@+id/subs_stub"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="top"
        android:layout_marginHorizontal="56dp"
        android:layout_marginTop="36dp"
        android:inflatedId="@+id/subs_panel"
        android:layout="@layout/subtitle_panel" />

    <!-- A held ←/→'s picture of where it's going (SeekPreview), moved above the bar at the target -->
    <ViewStub
        android:id="@+id/preview_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:inflatedId="@+id/preview"
        android:layout="@layout/preview" />
</merge>
