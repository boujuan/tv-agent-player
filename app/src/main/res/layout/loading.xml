<?xml version="1.0" encoding="utf-8"?>
<!-- The loading screen, while the agent finds the stream and the file opens (PROTOCOL.md, `loading`): the backdrop (or
     the poster), the title, what was heard and the step. Inflated on the first `loading`; gone at the first frame. Its
     black covers the picture's surface until then. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:ignore="Overdraw">

    <ImageView
        android:id="@+id/loading_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_bottom" />

    <ImageView
        android:id="@+id/loading_poster"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="96dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="64dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/loading_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="340dp"
            android:maxHeight="110dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/loading_title"
            style="@style/ScreenTitle" />

        <TextView
            android:id="@+id/loading_subtitle"
            style="@style/ScreenSubtitle" />

        <TextView
            android:id="@+id/loading_heard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#99FFFFFF"
            android:textSize="16sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Its animation runs on the render thread, and only while this screen is shown. -->
            <ProgressBar
                android:id="@+id/loading_spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                android:indeterminateTint="#CCFFFFFF" />

            <TextView
                android:id="@+id/loading_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E6FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
