<?xml version="1.0" encoding="utf-8"?>
<!-- Over the picture, bottom right (MarkerOverlay): the Skip intro / Skip recap button (white: OK presses it), a short
     toast after an automatic skip, and the Next episode card at the credits. Inflated the first time one shows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/chip"
        android:paddingHorizontal="22dp"
        android:paddingVertical="10dp"
        android:textColor="@color/on_chip"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/skipped"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/panel"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/next_card"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/panel"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next_episode"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/next_countdown"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="#FFFFFFFF" />

        <TextView
            android:id="@+id/next_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
