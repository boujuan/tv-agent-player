<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- largeHeap: the buffer lives on the Java heap (Media3's allocator), and 192 MB holds too few seconds of a
         REMUX (DESIGN.md, Memory). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_player"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false">

        <!-- The player screen. tv-agent opens it with `am start -n` (no extras: the link comes over the agent's
             socket, PROTOCOL.md), so only shell (holding DUMP) may start it. Its own task: the TV app's pill and
             lists open over it in theirs, which only pauses it. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Player" />

        <!-- Pairing: `tv-agent tv pair` sends the agent's address, the player port, the player token and the
             agent certificate's SHA-256 (shell only, like the TV app's ConfigReceiver). -->
        <receiver
            android:name=".PairReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
